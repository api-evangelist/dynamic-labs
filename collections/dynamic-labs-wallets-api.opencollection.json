{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dynamic Allowlists Wallets API",
    "version": "v0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Wallets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get wallets by user.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.dynamicauth.com/api/v0/environments/:environmentId/users/:userId/wallets",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "The ID of the Dynamic environment (project)."
              },
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "The ID of the user."
              }
            ]
          },
          "docs": "Returns the wallets linked to the specified user."
        }
      ]
    }
  ],
  "bundled": true
}