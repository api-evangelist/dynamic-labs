{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dynamic Allowlists Analytics API",
    "version": "v0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Analytics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get wallet analytics for an environment.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.dynamicauth.com/api/v0/environments/:environmentId/analytics/wallets",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "The ID of the Dynamic environment (project)."
              },
              {
                "name": "startDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns aggregate wallet analytics for the environment over an optional date range."
        }
      ]
    }
  ],
  "bundled": true
}