{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dynamic Allowlists Exports API",
    "version": "v0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Exports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Download an export by ID.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.dynamicauth.com/api/v0/environments/:environmentId/exports/:exportId",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "The ID of the Dynamic environment (project)."
              },
              {
                "name": "exportId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the file content for a previously requested data export."
        }
      ]
    }
  ],
  "bundled": true
}