{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dynamic Allowlists Environments API",
    "version": "v0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Environments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get an environment by ID.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.dynamicauth.com/api/v0/environments/:environmentId",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "The ID of the Dynamic environment (project)."
              }
            ]
          },
          "docs": "Returns the configuration and settings for the specified environment (project)."
        },
        {
          "info": {
            "name": "Update an environment.",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://app.dynamicauth.com/api/v0/environments/:environmentId",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "The ID of the Dynamic environment (project)."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates settings for the specified environment."
        }
      ]
    }
  ],
  "bundled": true
}